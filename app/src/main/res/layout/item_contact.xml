<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Circular Photo -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivItemPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#E5E7EB"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="Foto"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvItemNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Contacto"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/textColorPrimary"/>

                <TextView
                    android:id="@+id/tvItemTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(+504) 9999-9999"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvItemNota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nota o descripción..."
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"/>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:weightSum="4">

            <Button
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Llamar"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#10B981"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Compartir"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#3B82F6"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Editar"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#F59E0B"
                android:textColor="@color/white"
                android:layout_marginEnd="4dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="Borrar"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#EF4444"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
